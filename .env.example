# Spendly — Environment Variables

# Database (same as Maybe Rails)
DATABASE_URL=postgresql://maybe:maybe@localhost:5432/maybe_development

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI (for AI chat)
OPENAI_API_KEY=

# Yahoo Finance (no key needed, but can set timeout)
YAHOO_FINANCE_TIMEOUT=10

# App
APP_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
